model SiteSettings {
  id                String   @id @default(cuid())
  
  primaryFont       String   @default("Arial, sans-serif")
  headingFont       String   @default("Arial, sans-serif")
  bodyFont          String   @default("Arial, sans-serif")
  
  showHome          Boolean  @default(true)
  showAbout         Boolean  @default(true)
  showServices      Boolean  @default(true)
  showProjects      Boolean  @default(true)
  showContact       Boolean  @default(true)
  showLanguageSwitcher Boolean @default(true)
  
  whatsappNumber    String?  @default("5")
  
  smtpHost          String?  @default("")
  smtpPort          String?  @default("587")
  smtpUser          String?  @default("")
  smtpPass          String?  @default("")
  fromEmail         String?  @default("")
