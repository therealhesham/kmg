generator client {
  provider      = "prisma-client-js"
  // binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  logo        String 
  description String?  @db.Text
  website     String?
  order       Int      @default(0) 
  isActive    Boolean  @default(true)
  comingSoon  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("companies")
}

model Settings {
  id                String   @id @default(cuid())
  siteName          String   @default("KMG Investment")
  siteTagline       String   @default("Investment Excellence")
  siteSubtagline    String   @default("Building Tomorrow's Leaders")
  aboutTitle        String   @default("About KMG Group")
  aboutDescription  String   @db.VarChar(1000) @default("KMG Group is a leading investment firm dedicated to building and nurturing exceptional businesses. With a portfolio spanning diverse industries, we bring strategic vision, operational excellence, and sustainable growth to every venture we undertake.")
  emailPlaceholder  String   @default("Enter your email address")
  emailButtonText   String   @default("Notify Me")
  emailSuccessMsg   String   @default("Thank you! We'll notify you when we launch.")
  emailPromptMsg    String   @default("Be the first to experience the extraordinary")
  portfolioTitle    String   @default("Our Portfolio")
  contactTitle      String   @default("Contact Us")
  contactEmail      String   @default("info@kmggroup.com")
  contactPhone      String   @default("+1 (555) 123-4567")
  contactAddress    String   @default("123 Business District, City, Country")
  footerText        String   @default("© 2024 · All Rights Reserved")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("settings")
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("subscribers")
}


